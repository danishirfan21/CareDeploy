# Backend (apps/api reads this file via ../../.env)
DATABASE_URL=postgresql+asyncpg://caredeploy:caredeploy@localhost:5432/caredeploy
CORS_ORIGINS=http://localhost:3100

# Frontend (copy to apps/web/.env.local if you change the API address)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Voice agent (M3). Placeholders only: never commit real values.
# LiveKit project, used by the API (to mint scoped tokens) and by the worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret between the API and the worker (long random string).
VOICE_WORKER_SECRET=
# Worker only. Deliberately NOT OPENAI_API_KEY, so a general key is never spent by accident.
VOICE_OPENAI_API_KEY=
CAREDEPLOY_API_URL=http://localhost:8000
