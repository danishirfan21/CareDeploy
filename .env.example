# Backend (apps/api reads this file via ../../.env)
DATABASE_URL=postgresql+asyncpg://caredeploy:caredeploy@localhost:5432/caredeploy
CORS_ORIGINS=http://localhost:3100

# Frontend (copy to apps/web/.env.local if you change the API address)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Voice agent (M3). Placeholders only: never commit real values.
# LiveKit project, used by the API (to mint scoped tokens) and by the worker.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret between the API and the worker (long random string).
VOICE_WORKER_SECRET=
# Worker only. Deliberately NOT OPENAI_API_KEY, so a general key is never spent by accident.
VOICE_OPENAI_API_KEY=
CAREDEPLOY_API_URL=http://localhost:8000

# Exposure guard (see docs/security.md). The admin API has no user authentication.
# `production` refuses to start unless you acknowledge that with ALLOW_UNAUTHENTICATED_ADMIN=true.
APP_ENV=development
ALLOW_UNAUTHENTICATED_ADMIN=false
# Build-time switch for the /dev pages in a production web build (leave unset).
# NEXT_PUBLIC_ENABLE_DEV_PAGES=1

# Deployment evidence older than this many days is rejected. A conservative demonstration
# assumption, not an industry requirement (see docs/deployments.md).
DEPLOYMENT_EVIDENCE_MAX_AGE_DAYS=30
# Optional JSON price list for cost estimates. No prices ship with CareDeploy.
COST_RATES_FILE=
