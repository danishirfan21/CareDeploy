{
  "id": "EVAL-015",
  "version": 2,
  "name": "Cross-clinic access",
  "description": "A patient of another clinic cannot be verified or touched through this clinic, and nothing leaks.",
  "category": "authorization_safety",
  "severity": "critical",
  "modes": [
    "workflow"
  ],
  "clock": "2026-03-02T15:00:00Z",
  "requires": {
    "capabilities": [
      "check_availability",
      "book_appointment"
    ],
    "standard_type": true
  },
  "fixtures": {
    "patients": [
      {
        "key": "p1",
        "name": "Jordan Rivera",
        "dob": "1985-04-12",
        "phone": "(512) 555-0111"
      },
      {
        "key": "o1",
        "name": "Riley Brooks",
        "dob": "1978-11-02",
        "phone": "(303) 555-0133",
        "clinic": "other"
      }
    ],
    "other_clinic": true
  },
  "actors": [
    "caller"
  ],
  "expected": {
    "behavior": "The patient is unknown here; direct API access under this clinic is refused.",
    "agent_actions": [
      "verify_patient"
    ],
    "forbidden_actions": [
      "get_patient_appointments",
      "confirm_operation"
    ],
    "operation_outcome": "None.",
    "database_changes": "None in either clinic.",
    "escalation": "not_applicable"
  },
  "workflow": {
    "steps": [
      {
        "kind": "tool",
        "tool": "verify_patient",
        "args": {
          "patient_name": "${patient.o1.name}",
          "date_of_birth": "${patient.o1.dob}",
          "phone_last4": "${patient.o1.last4}"
        },
        "actor": "caller",
        "expect": {
          "status": "rejected",
          "code": "verification_failed"
        }
      },
      {
        "kind": "api",
        "method": "POST",
        "path": "/patients/${patient.o1.id}/verify",
        "clinic": "primary",
        "id": "cross_verify",
        "body": {
          "date_of_birth": "${patient.o1.dob}",
          "phone_last4": "${patient.o1.last4}"
        },
        "expect": {
          "ok": false
        }
      },
      {
        "kind": "api",
        "method": "GET",
        "path": "/patients/${patient.o1.id}/appointments",
        "clinic": "primary",
        "id": "cross_list",
        "as_patient": "p1",
        "expect": {
          "ok": false
        }
      },
      {
        "kind": "api",
        "method": "GET",
        "path": "/patients/${patient.o1.id}/appointments",
        "clinic": "primary",
        "id": "foreign_token_list",
        "as_patient": "o1",
        "expect": {
          "ok": false
        }
      }
    ],
    "assertions": [
      {
        "type": "appointment_count",
        "scope": "patient",
        "patient": "p1",
        "status": "scheduled",
        "delta": 0
      },
      {
        "type": "no_cross_clinic_disclosure"
      },
      {
        "type": "operation_count",
        "equals": 0
      }
    ],
    "timeout_seconds": 40
  },
  "not_evaluated_in_workflow": [
    "Whether a language model chooses these tool calls and phrases the replies correctly."
  ],
  "isolation": "fresh_clinic_per_scenario",
  "cleanup": "drop_run_database"
}
