{
  "id": "EVAL-005",
  "version": 1,
  "name": "Caller changes the date before confirming",
  "description": "After a proposal the caller asks for a different day; the old proposal is withdrawn and only the new one is booked.",
  "category": "conversation_handling",
  "severity": "high",
  "modes": [
    "workflow"
  ],
  "clock": "2026-03-02T15:00:00Z",
  "requires": {
    "capabilities": [
      "check_availability",
      "book_appointment"
    ],
    "standard_type": true
  },
  "fixtures": {
    "patients": [
      {
        "key": "p1",
        "name": "Jordan Rivera",
        "dob": "1985-04-12",
        "phone": "(512) 555-0111"
      }
    ]
  },
  "actors": [
    "caller"
  ],
  "expected": {
    "behavior": "Withdraw the stale proposal, search the new day, propose again and re-confirm.",
    "agent_actions": [
      "withdraw_pending_proposal",
      "propose_booking",
      "confirm_operation"
    ],
    "forbidden_actions": [
      "request_human_escalation"
    ],
    "operation_outcome": "One succeeded booking.",
    "database_changes": "Exactly one appointment, on the new day.",
    "escalation": "forbidden"
  },
  "workflow": {
    "steps": [
      {
        "kind": "tool",
        "tool": "get_appointment_availability",
        "args": {
          "appointment_type": "${standard_type}",
          "date_from": "${open_date}"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "tool",
        "tool": "verify_patient",
        "args": {
          "patient_name": "${patient.p1.name}",
          "date_of_birth": "${patient.p1.dob}",
          "phone_last4": "${patient.p1.last4}"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "tool",
        "tool": "propose_booking",
        "args": {
          "appointment_type": "${standard_type}",
          "slot_ref": "S1"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "say",
        "text": "Actually, could we do a different day instead?",
        "actor": "caller"
      },
      {
        "kind": "tool",
        "tool": "withdraw_pending_proposal",
        "args": {
          "reason": "caller changed the date"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "tool",
        "tool": "get_appointment_availability",
        "args": {
          "appointment_type": "${standard_type}",
          "date_from": "${open_date_2}"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "tool",
        "tool": "propose_booking",
        "args": {
          "appointment_type": "${standard_type}",
          "slot_ref": "S4"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "say",
        "text": "Yes, that one works",
        "actor": "caller"
      },
      {
        "kind": "tool",
        "tool": "confirm_operation",
        "args": {
          "caller_words": "Yes, that one works"
        },
        "actor": "caller",
        "expect": {
          "status": "committed"
        }
      }
    ],
    "assertions": [
      {
        "type": "appointment_count",
        "scope": "patient",
        "patient": "p1",
        "status": "scheduled",
        "delta": 1
      },
      {
        "type": "operation_count",
        "status": "succeeded",
        "delta": 1
      },
      {
        "type": "no_overlapping_appointments"
      },
      {
        "type": "proposal_count",
        "status": "pending",
        "equals": 0
      }
    ],
    "timeout_seconds": 40
  },
  "not_evaluated_in_workflow": [
    "Whether the model notices the change of mind and re-proposes without being told."
  ],
  "isolation": "fresh_clinic_per_scenario",
  "cleanup": "drop_run_database"
}
