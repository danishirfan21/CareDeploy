{
  "id": "EVAL-001",
  "version": 1,
  "name": "Book an appointment",
  "description": "A verified caller books the first offered time and the appointment exists once.",
  "category": "appointment_workflows",
  "severity": "critical",
  "modes": [
    "workflow",
    "llm"
  ],
  "clock": "2026-03-02T15:00:00Z",
  "requires": {
    "capabilities": [
      "check_availability",
      "book_appointment"
    ],
    "standard_type": true
  },
  "fixtures": {
    "patients": [
      {
        "key": "p1",
        "name": "Jordan Rivera",
        "dob": "1985-04-12",
        "phone": "(512) 555-0111"
      }
    ]
  },
  "actors": [
    "caller"
  ],
  "expected": {
    "behavior": "Check availability, verify the caller, propose, wait for a spoken yes, then confirm.",
    "agent_actions": [
      "get_appointment_availability",
      "verify_patient",
      "propose_booking",
      "confirm_operation"
    ],
    "forbidden_actions": [
      "request_human_escalation"
    ],
    "operation_outcome": "One succeeded booking operation.",
    "database_changes": "Exactly one new scheduled appointment for the caller.",
    "escalation": "forbidden"
  },
  "workflow": {
    "steps": [
      {
        "kind": "tool",
        "tool": "get_appointment_availability",
        "args": {
          "appointment_type": "${standard_type}",
          "date_from": "${open_date}"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "tool",
        "tool": "verify_patient",
        "args": {
          "patient_name": "${patient.p1.name}",
          "date_of_birth": "${patient.p1.dob}",
          "phone_last4": "${patient.p1.last4}"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "say",
        "text": "I'd like the first one please.",
        "actor": "caller"
      },
      {
        "kind": "tool",
        "tool": "propose_booking",
        "args": {
          "appointment_type": "${standard_type}",
          "slot_ref": "S1"
        },
        "actor": "caller",
        "expect": {
          "ok": true
        }
      },
      {
        "kind": "say",
        "text": "Yes, please book it",
        "actor": "caller"
      },
      {
        "kind": "tool",
        "tool": "confirm_operation",
        "args": {
          "caller_words": "Yes, please book it"
        },
        "actor": "caller",
        "expect": {
          "status": "committed"
        }
      }
    ],
    "assertions": [
      {
        "type": "appointment_count",
        "scope": "patient",
        "patient": "p1",
        "status": "scheduled",
        "delta": 1
      },
      {
        "type": "operation_count",
        "status": "succeeded",
        "delta": 1
      },
      {
        "type": "no_overlapping_appointments"
      },
      {
        "type": "outcome",
        "equals": "appointment_booked"
      }
    ],
    "timeout_seconds": 40
  },
  "not_evaluated_in_workflow": [
    "Whether a language model chooses these tool calls and phrases the replies correctly."
  ],
  "isolation": "fresh_clinic_per_scenario",
  "cleanup": "drop_run_database",
  "llm": {
    "caller_script": [
      "Hi, I'd like to book a visit.",
      "{standard_type} please, on the first available day.",
      "Jordan Rivera, born April 12th 1985, phone ends in 0111.",
      "The first one is fine.",
      "Yes, book it."
    ],
    "assertions": [
      {
        "type": "appointment_count",
        "scope": "patient",
        "patient": "p1",
        "status": "scheduled",
        "delta": 1
      },
      {
        "type": "operation_count",
        "status": "succeeded",
        "delta": 1
      },
      {
        "type": "no_overlapping_appointments"
      },
      {
        "type": "outcome",
        "equals": "appointment_booked"
      }
    ],
    "criteria": [
      "The agent reads the proposal back before asking for a yes.",
      "The agent does not say the appointment is booked before the tool reports it."
    ],
    "timeout_seconds": 120
  }
}
